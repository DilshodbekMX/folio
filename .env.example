# Folio server configuration. Copy to .env (loaded automatically) and uncomment what you need.
# Variables already set in the environment win. To read another file, set FOLIO_ENV_FILE=<path> in
# the environment (FOLIO_ENV_FILE=none reads no file). See README.md → Configuration for details.

# Where the server listens. Use 0.0.0.0 only behind a firewall or reverse proxy.
#PORT=3100
#HOST=127.0.0.1
# The URL people use (set it whenever Folio is reachable under a domain name):
#PUBLIC_ORIGIN=https://latex.example.com

# Everything Folio stores: projects, history, builds, database
#DATA_DIR=./data

# Compiler: docker (sandboxed TeX Live), local (latexmk on the host, NOT sandboxed), fake (tests)
#COMPILE_RUNNER=docker
#COMPILE_IMAGE=texlive/texlive:latest-full
#MAX_CONCURRENT_COMPILES=4
#COMPILE_TIMEOUT_SEC=240
#COMPILE_MEMORY=2g
#COMPILE_CPUS=2
#COMPILE_USER=1000:1000

# Accounts
#ALLOW_SIGNUP=false
#SESSION_TTL_DAYS=30

# Limits and logging
#MAX_UPLOAD_MB=50
#LOG_LEVEL=info
#WEB_DIST=web/dist

# Dev only (`npm run dev`): the Vite dev server's port. Its proxy follows PORT and HOST above;
# FOLIO_API points it at another server instead.
#VITE_PORT=5173
#FOLIO_API=http://127.0.0.1:3100
